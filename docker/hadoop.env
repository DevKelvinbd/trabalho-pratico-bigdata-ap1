# hadoop.env - Variáveis de Ambiente para Hadoop e Ecossistema Big Data
# Otimizado para Mac M4 (Apple Silicon) - Heap conservador para evitar OOM

HADOOP_HOME=/opt/hadoop
HADOOP_CONF_DIR=/opt/hadoop/etc/hadoop
CORE_CONF_fs_defaultFS=hdfs://namenode:8020
HDFS_CONF_dfs_replication=1
HDFS_CONF_dfs_permissions=false

# Limites de memória JVM
HADOOP_NAMENODE_OPTS="-Xms128m -Xmx384m"
HADOOP_DATANODE_OPTS="-Xms128m -Xmx384m"
YARN_RESOURCEMANAGER_OPTS="-Xms128m -Xmx384m"
YARN_NODEMANAGER_OPTS="-Xms128m -Xmx384m"
